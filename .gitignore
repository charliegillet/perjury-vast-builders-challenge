.env
.env.*
!.env.example
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
dist/
build/
.next/
lastframe/data/

# Event VM credentials and k8s config: never commit (the repo goes public for submission)
*.config
!config.example
kubeconfig
*kubeconfig*
*secret*.yaml
*secret*.yml

# PERJURY runtime cache: generated on the VM by code; only fixtures + frozen bench outputs are committed
cache/*
!cache/fixture_i24_index.json
!cache/fixture_scene_probes.json
!cache/fixture_truth.json
!cache/.gitkeep
.pytest_cache/

# From the official starter repo's .gitignore (secrets, junk)
secrets.yaml
secrets.*.yaml
config.yaml
*-config.yaml
!*.config.example
!*.example.yaml
*.log
tmp/
resp.json
verify-vm.sh

# run.sh debug logs
logs/

# real endpoints for the live VM run (see live-env.example.sh)
live-env.sh
